# Test server deletion using nofail mode

varnishtest "Delete server via cli using nofail mode"

feature cmd "command -v socat"
feature ignore_unknown_macro

barrier b1 cond 2 -cyclic

server s1 {
	rxreq
	barrier b1 sync
	txresp
} -repeat 2 -start

haproxy h1 -conf {
	global
	.if feature(THREAD)
		thread-groups 1
	.endif
	stats socket "${tmpdir}/h1/stats" level admin

	defaults
		mode http
		timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
		timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
		timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

	frontend fe1
		bind "fd@${fe1}"
		use_backend be1

	backend be1
		server srv ${s1_addr}:${s1_port}

	frontend fe2
		bind "fd@${fe2}"
		use_backend be2

	backend be2
		server srv ${s1_addr}:${s1_port}

	frontend fe_int
		bind "fd@${fint}"
		http-request return status 200
} -start

# wait for haproxy startup
client c0 -connect ${h1_fint_sock} {
	txreq
	rxresp
} -run

# Start a long request to temporarily block server deletion
client c1 -connect ${h1_fe1_sock} {
	txreq
	rxresp
	expect resp.status == "200"
} -start

shell {
	# Ensure srv-deleted is rejected if del server not yet performed
	out=$(echo "wait 300ms srv-deleted be1/srv" | socat -,ignoreeof=1 "${tmpdir}/h1/stats")
	[ "$out" = "Failed. Server not flagged for deletion." ] || \
	  { echo "expect failure: srv-deleted not rejected: ${out}"; exit 1; }

	# Try server deletion in normal mode
	# Active request must prevent it
	out=$(echo "del server be1/srv" | socat - "${tmpdir}/h1/stats")
	[ "$out" = "Only servers in maintenance mode can be deleted." ] || \
	  { echo "expect failure: normal server deletion still active not rejected: ${out}"; exit 1; }

	echo "disable server be1/srv" | socat -,ignoreeof=1 "${tmpdir}/h1/stats"
	out=$(echo "del server be1/srv" | socat -,ignoreeof=1 "${tmpdir}/h1/stats")
	[ "$out" = "Server still has connections attached to it, cannot remove it." ] || \
	  { echo "expect failure: normal server deletion with active conns not rejected: ${out}"; exit 1; }
	echo $out

	# Re-enable server - nofail is expected to automatically turn it off
	echo "enable server be1/srv" | socat -,ignoreeof=1 "${tmpdir}/h1/stats"

	# Flag server for deletion
	# Active request must prevent immediate success
	out=$(echo "del server be1/srv nofail" | socat - "${tmpdir}/h1/stats")
	[ "$out" = "Server flagged for deletion." ] || \
	  { echo "expect failure: nofail deletion rejected: ${out}"; exit 1; }
}

barrier b1 sync

shell {
	# Proceed to server deletion
	# Uses a wait timeout to cover the currently active request completion
	out=$(echo "wait 300ms srv-deleted be1/srv" | socat -,ignoreeof=1 "${tmpdir}/h1/stats")
	[ "$out" = "Done." ] || \
	  { echo "expect failure: wait srv-deleted failure: ${out}"; exit 1; }

	# Ensures server is not accessible anymore
	out=$(echo "enable server be1/srv" | socat - "${tmpdir}/h1/stats")
	[ "$out" = "No such server." ] || \
	  { echo "expect failure: server still present: ${out}"; exit 1; }
}

# Start a long request to temporarily block server deletion
client c2 -connect ${h1_fe2_sock} {
	txreq
	rxresp
	expect resp.status == "200"
} -start

shell {
	# Flag server for deletion as connection on it still active
	out=$(echo "del server be2/srv nofail" | socat -,ignoreeof=1 "${tmpdir}/h1/stats")
	[ "$out" = "Server flagged for deletion." ] || \
	  { echo "expect failure: server not flagged: ${out}"; exit 1; }

	# Run server deletion completion on background
	echo "wait 300ms srv-deleted be2/srv" | \
	  socat -,ignoreeof=1 "${tmpdir}/h1/stats" > "${tmpdir}/h1/out" 2>&1 &
	pid=$!

	# Cancel server deletion by settings its state
	echo "disable server be2/srv" | socat - "${tmpdir}/h1/stats"
}

barrier b1 sync

shell {
	# Ensure wait was interrupted as server deletion is cancelled
	wait $pid && out=$(cat "${tmpdir}/h1/out")
	[ "$out" = "Failed. Server not flagged for deletion." ] || \
	  { echo "expect failure: server deletion not cancelled: ${out}"; exit 1; }
}
